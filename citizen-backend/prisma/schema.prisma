generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  OFFICER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IDENTITY_VERIFIED
  DOCUMENTS_VERIFIED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  APPROVED
  REJECTED
  SIGNED
  COMPLETED
}

enum DocumentStatus {
  UPLOADED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  CORRECTION_REQUIRED
}

enum VerificationType {
  DOCUMENT
  AADHAAR
  PAN
  FACE
  FINGERPRINT
  E_KYC
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  FAILED
  MANUAL_REVIEW
}

enum FingerprintSessionStatus {
  PENDING_PAIRING
  PAIRED
  COMPLETED
  EXPIRED
}

enum FingerprintStep {
  RIGHT_INDEX
  RIGHT_MIDDLE
  RIGHT_RING
  RIGHT_PINKY
  RIGHT_THUMB
}

enum FingerprintSessionEventType {
  CREATED
  RESTARTED
  PAIRED
  STEP_COMPLETED
  COMPLETED
  EXPIRED
}

enum ConsentStatus {
  GRANTED
  DECLINED
  REVOKED
}

enum GeneratedDocumentSigningSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum NotificationType {
  APPLICATION_UPDATE
  DOCUMENT_UPDATE
  VERIFICATION_UPDATE
  SYSTEM
}

enum AIMessageRole {
  CITIZEN
  ASSISTANT
  SYSTEM
}

enum OfficerReviewStatus {
  NOT_ASSIGNED
  ASSIGNED
  IN_REVIEW
  REVIEWED
}

model User {
  id                  String                     @id @default(uuid()) @map("user_id") @db.Uuid
  email               String                     @unique @db.VarChar(320)
  passwordHash        String                     @map("password_hash")
  role                UserRole                   @default(CITIZEN)
  displayName         String?                    @map("display_name") @db.VarChar(150)
  isActive            Boolean                    @default(true) @map("is_active")
  lastLoginAt         DateTime?                  @map("last_login_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  citizenProfile      CitizenProfile?
  officer             Officer?
  documents           Document[]
  consents            Consent[]
  conversations       AIConversation[]
  notifications       Notification[]
  statusChanges       ApplicationStatusHistory[] @relation("StatusChangedBy")
  generatedDocumentsIssued GeneratedDocument[]    @relation("GeneratedDocumentsIssued")
  refreshTokens       RefreshToken[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model CitizenProfile {
  id                 String        @id @default(uuid()) @map("citizen_id") @db.Uuid
  userId             String        @unique @map("user_id") @db.Uuid
  fullName           String        @map("full_name") @db.VarChar(200)
  phone              String?       @map("mobile_number") @db.VarChar(30)
  dateOfBirth        DateTime?     @map("date_of_birth") @db.Date
  address            String?       @db.VarChar(500)
  city               String?       @db.VarChar(100)
  state              String?       @db.VarChar(100)
  pincode            String?       @db.VarChar(20)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  demoCitizenProfile DemoCitizenProfile?
  applications       Application[]
  verifications      Verification[]
  fingerprintSessions FingerprintSession[]
  consents           Consent[]
  generatedDocumentSigningSessions GeneratedDocumentSigningSession[]
  conversations      AIConversation[]

  @@index([createdAt])
  @@map("citizen_profiles")
}

// Demo-only identity registry. The unique mobile number, not the display name,
// is used to locate a profile during the mock OTP login flow.
model DemoCitizenProfile {
  id               String                @id @default(uuid()) @map("demo_citizen_profile_id") @db.Uuid
  profileCode      String                @unique @map("profile_code") @db.VarChar(50)
  normalizedMobile String                @unique @map("normalized_mobile") @db.VarChar(15)
  mockOtpHash      String                @map("mock_otp_hash")
  citizenProfileId String                @unique @map("citizen_profile_id") @db.Uuid
  isDemo           Boolean               @default(true) @map("is_demo")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  citizenProfile   CitizenProfile        @relation(fields: [citizenProfileId], references: [id], onDelete: Restrict)
  issuedDocuments  MockIssuedDocument[]

  @@index([createdAt])
  @@map("demo_citizen_profiles")
}

// Separate from uploaded Documents and application completion GeneratedDocuments.
// All values are synthetic fixtures for the JANSEVA-X hackathon demo.
model MockIssuedDocument {
  id                   String             @id @default(uuid()) @map("mock_issued_document_id") @db.Uuid
  documentCode         String             @unique @map("document_code") @db.VarChar(100)
  demoCitizenProfileId String             @map("demo_citizen_profile_id") @db.Uuid
  documentType         String             @map("document_type") @db.VarChar(150)
  displayName          String             @map("display_name") @db.VarChar(200)
  issuer               String             @db.VarChar(200)
  issueDate            DateTime           @map("issue_date") @db.Date
  expiryDate           DateTime?          @map("expiry_date") @db.Date
  status               String             @default("AVAILABLE") @db.VarChar(50)
  structuredFields     Json?              @map("structured_fields")
  isDemo               Boolean            @default(true) @map("is_demo")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  demoCitizenProfile   DemoCitizenProfile @relation(fields: [demoCitizenProfileId], references: [id], onDelete: Cascade)
  applicationMockIssuedDocuments ApplicationMockIssuedDocument[]

  @@index([demoCitizenProfileId, status])
  @@index([documentType])
  @@map("mock_issued_documents")
}

model RefreshToken {
  id        String    @id @default(uuid()) @map("refresh_token_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Officer {
  id                   String        @id @default(uuid()) @map("officer_id") @db.Uuid
  userId               String        @unique @map("user_id") @db.Uuid
  employeeIdentifier   String        @unique @map("employee_identifier") @db.VarChar(100)
  department           String        @db.VarChar(150)
  designation          String        @db.VarChar(150)
  isActive             Boolean       @default(true) @map("is_active")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedApplications Application[]

  @@index([department])
  @@map("officers")
}

model GovernmentService {
  id                   String               @id @default(uuid()) @map("service_id") @db.Uuid
  name                 String               @db.VarChar(200)
  slug                 String               @unique @db.VarChar(100)
  description          String?
  isActive             Boolean              @default(true) @map("is_active")
  isPrototype          Boolean              @default(true) @map("is_prototype")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  requirements         ServiceRequirement[]
  applications         Application[]

  @@index([isActive])
  @@index([createdAt])
  @@map("government_services")
}

model ServiceRequirement {
  id          String            @id @default(uuid()) @map("service_requirement_id") @db.Uuid
  serviceId   String            @map("service_id") @db.Uuid
  name        String            @db.VarChar(200)
  description String?
  isRequired  Boolean           @default(true) @map("is_required")
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  service     GovernmentService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, name])
  @@index([serviceId, sortOrder])
  @@map("service_requirements")
}

model Application {
  id                    String                     @id @default(uuid()) @map("application_id") @db.Uuid
  citizenId             String                     @map("citizen_id") @db.Uuid
  serviceId             String                     @map("service_id") @db.Uuid
  applicationNumber     String                     @unique @map("application_number") @db.VarChar(100)
  status                ApplicationStatus          @default(DRAFT)
  formData              Json?                      @map("form_data")
  correctionReason      String?                    @map("correction_reason")
  assignedOfficerId     String?                    @map("assigned_officer_id") @db.Uuid
  reviewStatus          OfficerReviewStatus        @default(NOT_ASSIGNED) @map("review_status")
  assignedAt            DateTime?                  @map("assigned_at")
  reviewedAt            DateTime?                  @map("reviewed_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  submittedAt           DateTime?                  @map("submitted_at")
  citizen               CitizenProfile             @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  service               GovernmentService          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedOfficer       Officer?                   @relation(fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  applicationDocuments  ApplicationDocument[]
  mockIssuedDocumentAttachments ApplicationMockIssuedDocument[]
  verifications         Verification[]
  fingerprintSessions   FingerprintSession[]
  consents              Consent[]
  statusHistory         ApplicationStatusHistory[]
  generatedDocuments    GeneratedDocument[]
  notifications         Notification[]
  conversations         AIConversation[]

  @@index([citizenId, createdAt])
  @@index([serviceId, status])
  @@index([status, createdAt])
  @@index([assignedOfficerId, reviewStatus])
  @@map("applications")
}

model Document {
  id                 String                @id @default(uuid()) @map("document_id") @db.Uuid
  userId             String                @map("user_id") @db.Uuid
  documentType       String                @map("document_type") @db.VarChar(150)
  expectedDocumentType String?             @map("expected_document_type") @db.VarChar(150)
  originalFilename   String                @map("original_filename") @db.VarChar(500)
  storageKey         String                @unique @map("storage_key") @db.VarChar(1000)
  mimeType           String                @map("mime_type") @db.VarChar(150)
  fileSizeBytes      Int                   @map("file_size_bytes")
  sha256             String                @map("sha256") @db.Char(64)
  status             DocumentStatus        @default(UPLOADED)
  aiExtractionResult Json?                 @map("ai_extraction_result")
  rejectionReason    String?               @map("rejection_reason")
  uploadedAt         DateTime              @default(now()) @map("uploaded_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  owner              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  applicationLinks   ApplicationDocument[]
  verifications      Verification[]

  @@index([userId, uploadedAt])
  @@index([status])
  @@map("documents")
}

model ApplicationDocument {
  id                 String      @id @default(uuid()) @map("application_document_id") @db.Uuid
  applicationId      String      @map("application_id") @db.Uuid
  documentId         String      @map("document_id") @db.Uuid
  requirementId      String?     @map("requirement_id") @db.Uuid
  label              String?     @db.VarChar(200)
  createdAt          DateTime    @default(now()) @map("created_at")
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document           Document    @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([applicationId, documentId])
  @@index([documentId])
  @@index([applicationId])
  @@map("application_documents")
}

// A demo-only reuse link. This intentionally remains distinct from Document
// uploads: mock issued documents have no citizen-uploaded file or storage key.
model ApplicationMockIssuedDocument {
  id                   String             @id @default(uuid()) @map("application_mock_issued_document_id") @db.Uuid
  applicationId        String             @map("application_id") @db.Uuid
  mockIssuedDocumentId String             @map("mock_issued_document_id") @db.Uuid
  requirementId        String             @map("requirement_id") @db.Uuid
  attachedAt           DateTime           @default(now()) @map("attached_at")
  application          Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  mockIssuedDocument   MockIssuedDocument @relation(fields: [mockIssuedDocumentId], references: [id], onDelete: Restrict)

  @@unique([applicationId, mockIssuedDocumentId, requirementId])
  @@index([applicationId])
  @@map("application_mock_issued_documents")
}

model Verification {
  id               String             @id @default(uuid()) @map("verification_id") @db.Uuid
  applicationId    String             @map("application_id") @db.Uuid
  citizenId        String             @map("citizen_id") @db.Uuid
  documentId       String?            @map("document_id") @db.Uuid
  type             VerificationType
  status           VerificationStatus @default(PENDING)
  providerReference String?           @map("provider_reference") @db.VarChar(255)
  result           Json?
  failureReason    String?            @map("failure_reason")
  verifiedAt       DateTime?          @map("verified_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  application      Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  citizen          CitizenProfile     @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  document         Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  fingerprintSession FingerprintSession?

  @@index([applicationId, status])
  @@index([citizenId, type])
  @@index([documentId])
  @@unique([documentId, type])
  @@map("verifications")
}

// QR pairing/session state only. No fingerprint images, templates, minutiae, or biometric secrets are stored.
model FingerprintSession {
  id                   String                   @id @default(uuid()) @map("fingerprint_session_id") @db.Uuid
  verificationId       String                   @unique @map("verification_id") @db.Uuid
  applicationId        String                   @map("application_id") @db.Uuid
  citizenId            String                   @map("citizen_id") @db.Uuid
  status               FingerprintSessionStatus @default(PENDING_PAIRING)
  pairingChallengeHash String                   @map("pairing_challenge_hash") @db.Char(64)
  providerReference    String                   @map("provider_reference") @db.VarChar(255)
  completedSteps       FingerprintStep[]        @default([]) @map("completed_steps")
  pairedAt             DateTime?                @map("paired_at")
  completedAt          DateTime?                @map("completed_at")
  expiresAt            DateTime                 @map("expires_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  verification         Verification             @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  application          Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  citizen              CitizenProfile           @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  events               FingerprintSessionEvent[]

  @@index([applicationId, citizenId])
  @@index([expiresAt])
  @@map("fingerprint_sessions")
}

// Immutable safe audit entries for QR-session operations. Metadata never contains a pairing challenge or biometric data.
model FingerprintSessionEvent {
  id          String                      @id @default(uuid()) @map("fingerprint_session_event_id") @db.Uuid
  sessionId   String                      @map("fingerprint_session_id") @db.Uuid
  type        FingerprintSessionEventType
  step        FingerprintStep?
  metadata    Json?
  createdAt   DateTime                    @default(now()) @map("created_at")
  session     FingerprintSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("fingerprint_session_events")
}

model Consent {
  id              String        @id @default(uuid()) @map("consent_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  citizenId       String        @map("citizen_id") @db.Uuid
  applicationId   String        @map("application_id") @db.Uuid
  consentType     String        @map("consent_type") @db.VarChar(150)
  consentText     String        @map("consent_text")
  consentVersion  String        @map("consent_version") @db.VarChar(50)
  status          ConsentStatus @default(GRANTED)
  ipAddress       String?       @map("ip_address") @db.VarChar(64)
  deviceMetadata  Json?         @map("device_metadata")
  recordedAt      DateTime      @default(now()) @map("recorded_at")
  revokedAt       DateTime?     @map("revoked_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  citizen         CitizenProfile @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  signingSession  GeneratedDocumentSigningSession?

  @@index([applicationId, status])
  @@index([citizenId, recordedAt])
  @@map("consents")
}

model AIConversation {
  id             String        @id @default(uuid()) @map("conversation_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  citizenId      String?       @map("citizen_id") @db.Uuid
  applicationId  String?       @map("application_id") @db.Uuid
  title          String?       @db.VarChar(255)
  context        Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  citizen        CitizenProfile? @relation(fields: [citizenId], references: [id], onDelete: SetNull)
  application    Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages       AIMessage[]

  @@index([userId, createdAt])
  @@index([citizenId])
  @@index([applicationId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String        @id @default(uuid()) @map("message_id") @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AIMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model ApplicationStatusHistory {
  id              String            @id @default(uuid()) @map("status_history_id") @db.Uuid
  applicationId   String            @map("application_id") @db.Uuid
  status          ApplicationStatus
  note            String?
  changedByUserId String?           @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy       User?             @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([status])
  @@map("application_status_history")
}

model GeneratedDocument {
  id                String      @id @default(uuid()) @map("generated_document_id") @db.Uuid
  applicationId     String      @map("application_id") @db.Uuid
  documentType      String      @map("document_type") @db.VarChar(150)
  storageKey        String      @unique @map("storage_key") @db.VarChar(1000)
  mimeType          String      @map("mime_type") @db.VarChar(150)
  signatureStatus   String      @default("NOT_SIGNED") @map("signature_status") @db.VarChar(50)
  originalFilename  String?     @map("original_filename") @db.VarChar(500)
  fileSizeBytes     Int?        @map("file_size_bytes")
  sha256            String?     @db.Char(64)
  templateVersion   String?     @map("template_version") @db.VarChar(100)
  generatedByUserId String?     @map("generated_by_user_id") @db.Uuid
  issuanceKey       String?     @unique @map("issuance_key") @db.Char(64)
  generatedAt       DateTime    @default(now()) @map("generated_at")
  signedAt          DateTime?   @map("signed_at")
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  generatedBy       User?       @relation("GeneratedDocumentsIssued", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  signingSessions   GeneratedDocumentSigningSession[]

  @@index([applicationId, generatedAt])
  @@map("generated_documents")
}

// Short-lived demo signing state only. Challenges are retained solely as SHA-256 hashes.
model GeneratedDocumentSigningSession {
  id                  String                              @id @default(uuid()) @map("generated_document_signing_session_id") @db.Uuid
  generatedDocumentId String                              @map("generated_document_id") @db.Uuid
  citizenId           String                              @map("citizen_id") @db.Uuid
  consentId           String?                             @unique @map("consent_id") @db.Uuid
  status              GeneratedDocumentSigningSessionStatus @default(PENDING)
  providerReference   String                              @map("provider_reference") @db.VarChar(255)
  signingChallengeHash String                             @map("signing_challenge_hash") @db.Char(64)
  documentSha256      String                              @map("document_sha256") @db.Char(64)
  expiresAt           DateTime                            @map("expires_at")
  completedAt         DateTime?                           @map("completed_at")
  createdAt           DateTime                            @default(now()) @map("created_at")
  updatedAt           DateTime                            @updatedAt @map("updated_at")
  generatedDocument   GeneratedDocument                   @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)
  citizen             CitizenProfile                      @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  consent             Consent?                            @relation(fields: [consentId], references: [id], onDelete: SetNull)

  @@index([generatedDocumentId, status])
  @@index([citizenId, expiresAt])
  @@map("generated_document_signing_sessions")
}

model Notification {
  id             String           @id @default(uuid()) @map("notification_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  applicationId  String?          @map("application_id") @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(255)
  message        String
  isRead         Boolean          @default(false) @map("is_read")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application    Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([applicationId])
  @@map("notifications")
}
