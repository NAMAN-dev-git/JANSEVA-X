NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/janseva_x?schema=public"
JWT_SECRET="replace-with-a-long-random-development-secret"
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
# Comma-separated explicit origins. Wildcard (*) is rejected in production.
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=4
# Background submission-ticket worker polling interval (milliseconds).
SUBMISSION_WORKER_POLL_INTERVAL_MS=2000
# DEMO/PROTOTYPE only: enables active officer/admin mock completion-certificate issuance.
DEMO_DOCUMENT_ISSUER_ENABLED=false
