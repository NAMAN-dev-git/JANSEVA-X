# Backend API URL exposed to the browser by Vite.
# Leave this empty for local laptop development (it falls back to http://localhost:4000/api).
# For LAN testing from a phone, set it to the laptop's LAN address, for example:
# VITE_API_URL=http://192.168.1.12:4000/api
VITE_API_URL=

# Phone-reachable URL for the laptop-hosted frontend during LAN demos.
# Set this to the laptop's LAN address, e.g. http://192.168.x.x:5173.
VITE_PUBLIC_LAN_URL=
